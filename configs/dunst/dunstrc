# Archcraft GE | Dunst notifications
[global]
    monitor = 0
    follow = "mouse"
    width = (300, 420)
    height = 300
    origin = top-right
    offset = (18, 52)
    scale = 0
    notification_limit = 6
    progress_bar = true
    progress_bar_height = 6
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#35d9ff"
    gap_size = 8
    font = "JetBrains Mono 9"
    line_height = 0
    markup = full
    format = "<b>%s</b>\\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicates = false
    sticky_history = yes
    history_length = 20
    corner_radius = 10
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#151e2b"
    foreground = "#8293a8"
    frame_color = "#334155"
    timeout = 4

[urgency_normal]
    background = "#0d111b"
    foreground = "#e6f1ff"
    frame_color = "#35d9ff"
    timeout = 6

[urgency_critical]
    background = "#24131a"
    foreground = "#fff0f0"
    frame_color = "#ff5d76"
    timeout = 0
